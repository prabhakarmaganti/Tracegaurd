{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{backend/**,frontend/**,db/**}"
    }
  },
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/frontend/:path*"
    },
    {
      "source": "/frontend/:path*",
      "destination": "/frontend/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__path=health"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?__path=docs"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py?__path=redoc"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__path=openapi.json"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__path=health"
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/index.py?__path=favicon.ico"
    },
    {
      "source": "/index.html",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    }
  ]
}
